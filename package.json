{
  "name": "@hyperscale0/adl",
  "version": "1.0.355",
  "description": "The Adapter Declaration Language: generic evidence, provider declarations and conformance.",
  "keywords": [
    "adl",
    "adapter",
    "conformance",
    "fintech",
    "json-schema",
    "payments",
    "provider"
  ],
  "homepage": "https://github.com/hyperscale0/hyperscale-adl#readme",
  "bugs": {
    "url": "https://github.com/hyperscale0/hyperscale-adl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperscale0/hyperscale-adl.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./boundary-fixture": "./src/boundary-fixture.ts",
    "./boundary-adapters": "./src/boundary-adapters.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE.md",
    "NOTICE.md",
    "AUTHORS",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "conformance",
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc-rs -p tsconfig.build.json",
    "check": "bun test && tsc-rs -p tsconfig.json",
    "conformance": "bun scripts/conformance.ts",
    "postpack": "bun scripts/pack-exports.ts restore",
    "prepack": "bun run build && bun scripts/pack-exports.ts apply",
    "test": "bun test",
    "typecheck": "tsc-rs -p tsconfig.json"
  },
  "dependencies": {
    "@hyperscale0/udl": "1.0.355",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "bun-types": "1.4.3",
    "tsc-rs": "0.7.0"
  },
  "author": "Hyperscale LLC",
  "contributors": [
    "Meshael AlBakaawi",
    "Amir Ayub",
    "Sara AlBakaawi"
  ]
}
