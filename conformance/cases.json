{
  "description": "Generic declaration refusals. Boundary evidence shape checks are in conformance.spec.ts.",
  "base": "../src/boundary-fixture.ts",
  "cases": [
    {
      "id": "operation-map-empty",
      "title": "operation-map-empty",
      "why": "operation-map-empty",
      "mutate": {
        "set": [
          {
            "path": ["operationMap"],
            "value": {}
          }
        ]
      },
      "load": "accepts",
      "conformance": ["operation_map_empty"]
    },
    {
      "id": "resource-binding-missing",
      "title": "resource-binding-missing",
      "why": "resource-binding-missing",
      "mutate": {
        "set": [
          {
            "path": ["bindings"],
            "value": {}
          }
        ]
      },
      "load": "accepts",
      "conformance": ["resource_binding_missing"]
    },
    {
      "id": "operation-key-mismatch",
      "title": "operation-key-mismatch",
      "why": "operation-key-mismatch",
      "mutate": {
        "set": [
          {
            "path": ["operationMap", "boundary.observe", "operation"],
            "value": "wrong"
          }
        ]
      },
      "load": {
        "throws": "must match operation"
      },
      "conformance": ["declaration_invalid"]
    },
    {
      "id": "invalid-provider",
      "title": "invalid-provider",
      "why": "invalid-provider",
      "mutate": {
        "set": [
          {
            "path": ["provider"],
            "value": "Invalid Adapter"
          }
        ]
      },
      "load": {
        "throws": "invalid provider key"
      },
      "conformance": ["declaration_invalid"]
    },
    {
      "id": "optional-subject-requirement",
      "title": "optional-subject-requirement",
      "why": "optional-subject-requirement",
      "mutate": {
        "set": [
          {
            "path": ["operationMap", "boundary.observe", "subjectRequirements"],
            "value": [
              {
                "name": "reference",
                "type": "text",
                "optional": true
              }
            ]
          }
        ]
      },
      "load": {
        "throws": "action requirements cannot be optional"
      },
      "conformance": ["declaration_invalid"]
    },
    {
      "id": "invalid-subject-field",
      "title": "invalid-subject-field",
      "why": "invalid-subject-field",
      "mutate": {
        "set": [
          {
            "path": ["operationMap", "boundary.observe", "subjectRequirements"],
            "value": [
              {
                "name": "reference",
                "type": "unknown"
              }
            ]
          }
        ]
      },
      "load": {
        "throws": "does not match UDL"
      },
      "conformance": ["declaration_invalid"]
    }
  ]
}
