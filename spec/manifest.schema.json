        },
        "resourceKind": {
          "type": "string",
          "pattern": "\\S"
        },
        "timestampField": {
          "type": "string",
          "enum": [
            "activeAt",
            "completedAt",
            "failedAt",
            "returnedAt",
            "receivedAt",
            "clearedAt",
            "expiredAt",
            "voidedAt",
            "postedAt",
            "refundedAt"
