            "target": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80,
                  "pattern": "^[a-z][a-zA-Z0-9_]*$"
                },
                {
                  "minItems": 1,
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^[a-z][a-zA-Z0-9_]*$"
                  }
                }
              ]
