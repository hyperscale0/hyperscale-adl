    "BoundaryInstruction": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "readOnly": true,
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "environment": {
          "type": "string",
          "enum": [
            "sandbox",
            "live"
          ]
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "productBuildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "buildDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "target": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "attachment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "instanceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": [
            "kind",
            "attachment",
            "instanceId"
          ],
          "additionalProperties": false
        },
        "sourceAccountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "destinationAccountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "amount": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,17}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
        }
      },
      "required": [
        "id",
        "environment",
        "tenantId",
        "productId",
        "productBuildId",
        "buildDigest",
        "target",
        "sourceAccountId",
        "destinationAccountId",
        "amount",
        "currency",
        "adapter"
      ],
      "additionalProperties": false
    },
    "BoundaryObservation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "readOnly": true,
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
        },
        "externalReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "instructionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "outcome": {
          "type": "string",
          "enum": [
            "acknowledged",
            "unknown",
            "confirmed",
            "rejected"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "adapter",
        "externalReference",
        "instructionId",
        "outcome",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "operationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "obligationKind",
        "operation",
        "resourceIdPath",
        "resourceKind"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "pattern": "\\S"
        },
        "direction": {
          "type": "string",
          "enum": [
            "tenant_initiated",
            "system_settlement"
          ]
        },
        "envelope": {
          "type": "string",
          "enum": [
            "http_200_body_status",
            "http_status_error_body",
            "unconfirmed_until_live"
          ]
        },
        "meter": {
          "type": "string",
          "pattern": "\\S"
        },
        "obligationKind": {
          "type": "string",
          "pattern": "\\S"
        },
        "resourceIdPath": {
          "type": "string",
          "pattern": "\\S"
        },
        "resourceKind": {
          "type": "string",
          "pattern": "\\S"
        },
        "subjectRequirements": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/objectField"
              },
              {
                "not": {
                  "required": [
                    "optional"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "webhookTransitionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventKind",
        "operationName",
        "optionalPayloadFields",
        "requiredFieldGroups",
        "requiredPayloadFields",
        "resourceIdField",
        "resourceKind",
        "timestampField"
      ],
      "properties": {
        "eventKind": {
          "type": "string",
          "pattern": "\\S"
        },
        "operationName": {
          "type": "string",
          "pattern": "\\S"
        },
        "optionalPayloadFields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "requiredFieldGroups": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "requiredPayloadFields": {
          "type": "array",
          "items": {
            "type": "string",
