{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hyperscale0/hyperscale-adl/main/spec/manifest.schema.json",
  "title": "Hyperscale provider adapter manifest",
  "description": "One provider adapter declaration. Generated from src/vocabulary.ts by scripts/emit-spec.ts; edit that, never this file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bindings",
    "capability",
    "config",
    "egress",
    "operationMap",
    "provider",
    "webhookMap"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
    },
    "capability": {
      "type": "string",
      "pattern": "\\S"
    },
    "domain": {
      "type": "string",
      "pattern": "\\S"
    },
    "egress": {
      "type": "string",
      "enum": [
        "none",
        "rest",
        "sync_clearance"
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "strict",
          "claim",
          "confirmation_only",
          "evidence_only"
        ]
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "credentialRef": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "source"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "source": {
                  "const": "environment"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "account",
                "service",
                "source"
              ],
              "properties": {
                "account": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "service": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "source": {
                  "const": "keychain"
                }
              }
            }
          ]
        }
      }
    },
    "operationMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/operationBinding"
      }
    },
    "webhookMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/webhookTransitionPlan"
      }
    }
  },
  "$defs": {
    "objectField": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z][a-zA-Z0-9_]*$"
            },
            "optional": {
              "type": "boolean",
              "const": true
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "type": {
              "type": "string",
              "const": "money"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            "minimum": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            },
            "maximum": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})$"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "additionalProperties": false
        },
        {
